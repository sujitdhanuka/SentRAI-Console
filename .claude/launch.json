{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sentrai-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "port": 8002,
      "autoPort": true
    },
    {
      "name": "console-ui",
      "runtimeExecutable": "npm",
