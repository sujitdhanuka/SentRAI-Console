{
  "name": "sentrai-console-node",
  "version": "1.0.0",
  "description": "SentrAI Compliance Console — NestJS port of the RBI SentrAI Framework compliance backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "db:convert": "ts-node -r tsconfig-paths/register src/scripts/sqlite-to-mariadb.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/js-yaml": "^4.0.9",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "mysql2": "^3.24.6",
    "neo4j-driver": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tree-sitter-wasms": "^0.1.13",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1",
    "web-tree-sitter": "^0.24.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "multer": "^2.5.0",
    "uuid": "$uuid",
    "qs": "^6.17.1",
    "lodash": "^4.18.0",
    "js-yaml@^3": "^3.15.2",
    "js-yaml@^4": "^4.3.2",
    "picomatch@^4": "^4.0.4",
    "tmp": "^0.2.6",
    "body-parser@^1": "^1.20.9",
    "proxy-addr": "^2.0.8",
    "handlebars": "^4.7.10",
    "fast-uri@^3": "^3.1.9",
    "file-type@^20": "^21.3.2",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^2": "^2.1.7",
    "brace-expansion@^5": "^5.0.12",
    "browserslist": "^4.29.5",
    "baseline-browser-mapping": "^2.11.34",
    "ajv": "^8.18.0",
    "webpack": "^5.104.1",
    "path-to-regexp@^0.2": "^1.9.0",
    "typeorm": {
      ".": "$typeorm",
      "glob": "^14.0.3"
    },
    "@nestjs/cli": {
      ".": "$@nestjs/cli",
      "glob": "^14.0.3"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
