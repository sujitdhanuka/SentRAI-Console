# ── Server ────────────────────────────────────────────────────────────────
PORT=8002
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://your-internal-dashboard.example.com

# ── Database ──────────────────────────────────────────────────────────────
# DB_PROVIDER selects the engine at runtime: "sqlite" (local) | "mariadb" (prod/Hostinger)
DB_PROVIDER=sqlite
SQLITE_PATH=./dev.db
# MariaDB / MySQL (Hostinger) — only used when DB_PROVIDER=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_USER=sentrai
# The DB password is read from DB_PASSWORD, falling back to the conventional
# MYSQL_PWD env var — set ONE of them (never commit the value to this file).
#DB_PASSWORD=
#MYSQL_PWD=
DB_NAME=sentrai_compliance
# Auto-create schema on boot instead of running migrations (handy on shared hosting)
DB_SYNCHRONIZE=true

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production (>=32 chars). The app refuses to boot in production
# (NODE_ENV=production or DB_PROVIDER=mariadb) with a missing/default/short secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Bootstrap admin (created on first boot only). In production, set a strong
# password (>=12 chars) here — or leave it unset and the app generates a strong
# random one and prints it ONCE to the boot log. The dev default admin123 is
# never used in production. Change the password after first sign-in.
#SEED_ADMIN_EMAIL=admin@yourbank.com
#SEED_ADMIN_PASSWORD=

# ── Security / deployment posture ─────────────────────────────────────────
# NODE_ENV=production enables production hardening (see below).
#NODE_ENV=production
# Allow browsing/scanning arbitrary server filesystem paths and pointing
# projects at server directories. DANGEROUS on hosted/shared hosts (arbitrary
# file read). Defaults OFF in production; hosted users upload codebase ZIPs.
#ALLOW_SERVER_FS=false
# Expose the Swagger UI at /docs. Defaults OFF in production.
#EXPOSE_DOCS=false

# ── Neo4j (optional — graph lineage; runs in mock mode if unreachable) ─────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Drift & inventory thresholds ──────────────────────────────────────────
PSI_WARNING_THRESHOLD=0.10
PSI_ALERT_THRESHOLD=0.20
ACCURACY_DROP_ALERT_PCT=0.05
INVENTORY_UPDATE_SLA_DAYS=180
