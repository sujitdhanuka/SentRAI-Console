# ── Server ────────────────────────────────────────────────────────────────
PORT=8002
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://your-internal-dashboard.example.com

# ── Database ──────────────────────────────────────────────────────────────
# DB_PROVIDER selects the engine at runtime: "sqlite" (local) | "mariadb" (prod/Hostinger).
# IMPORTANT: SQLite writes a file inside the app directory, which most hosts WIPE
# on every redeploy — you WILL lose all data. Any hosted/production deployment
# MUST use the persistent MariaDB. If MYSQL_PWD (or DB_PASSWORD) and DB_HOST are
# set, the app auto-selects MariaDB even without DB_PROVIDER. In production on
# SQLite the app logs a loud DATA DURABILITY WARNING but still boots (so a config
# choice never takes the site down); set REQUIRE_PERSISTENT_DB=true to make it a
# hard failure instead.
DB_PROVIDER=sqlite
SQLITE_PATH=./dev.db
# MariaDB / MySQL (Hostinger) — the persistent database for any real deployment.
DB_HOST=localhost
DB_PORT=3306
DB_USER=sentrai
# The DB password is read from DB_PASSWORD, falling back to the conventional
# MYSQL_PWD env var — set ONE of them (never commit the value to this file).
#DB_PASSWORD=
#MYSQL_PWD=
DB_NAME=sentrai_compliance
# Auto-create/extend schema on boot instead of running migrations (handy on shared
# hosting). Additive on MariaDB — safe across redeploys; never remove entity columns.
DB_SYNCHRONIZE=true
# Silence the durability warning if SQLITE_PATH is a mounted, persistent volume.
#ALLOW_EPHEMERAL_SQLITE=false
# Make an ephemeral-SQLite production a hard boot failure instead of a warning.
#REQUIRE_PERSISTENT_DB=false

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production (>=32 chars). The app refuses to boot in production
# (NODE_ENV=production or DB_PROVIDER=mariadb) with a missing/default/short secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Bootstrap admin (created on first boot only). In production, set a strong
# password (>=12 chars) here — or leave it unset and the app generates a strong
# random one and prints it ONCE to the boot log. The dev default admin123 is
# never used in production. Change the password after first sign-in.
#SEED_ADMIN_EMAIL=admin@yourbank.com
#SEED_ADMIN_PASSWORD=
# Locked out? The seed is create-only and never overwrites an existing admin's
# password. Set SEED_ADMIN_RESET=true (with SEED_ADMIN_PASSWORD) and restart to
# force the existing admin's password to SEED_ADMIN_PASSWORD, then REMOVE this
# flag and restart again.
#SEED_ADMIN_RESET=true

# ── Security / deployment posture ─────────────────────────────────────────
# NODE_ENV=production enables production hardening (see below).
#NODE_ENV=production
# Allow browsing/scanning arbitrary server filesystem paths and pointing
# projects at server directories. DANGEROUS on hosted/shared hosts (arbitrary
# file read). Defaults OFF in production; hosted users upload codebase ZIPs.
#ALLOW_SERVER_FS=false
# Expose the Swagger UI at /docs. Defaults OFF in production.
#EXPOSE_DOCS=false
# Where uploaded project codebases are extracted (zip/folder/GitHub sources).
# Defaults to <cwd>/workspaces. Set this to a WRITABLE, persistent path if the
# app root is read-only (a common cause of "codebase upload failed" on shared
# hosting).
#WORKSPACES_DIR=/home/youruser/sentrai-workspaces

# ── Neo4j (optional — graph lineage; runs in mock mode if unreachable) ─────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Drift & inventory thresholds ──────────────────────────────────────────
PSI_WARNING_THRESHOLD=0.10
PSI_ALERT_THRESHOLD=0.20
ACCURACY_DROP_ALERT_PCT=0.05
INVENTORY_UPDATE_SLA_DAYS=180
